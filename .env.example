# Konfigurasi POS Kacaw (frontend). Salin ke `.env` lalu sesuaikan.
# Variabel harus berawalan VITE_ agar terekspos ke kode (import.meta.env).

# Base URL backend POS Pro (Laravel). Default: server lokal artisan serve.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Backend aktif: firebase (default) atau laravel (legacy).
VITE_BACKEND=firebase

# Google Sign-In (native + web). Isi dengan OAuth Client ID dari Google Cloud
# Console. Untuk web/dev pakai Client ID tipe "Web application"; untuk Android
# server verification pakai Client ID Web yang sama (server_client_id).
# Kosongkan kalau belum pakai login Google.
VITE_GOOGLE_CLIENT_ID=

# Firebase project Shakala POS. Web config values boleh diisi melalui env.
VITE_FIREBASE_API_KEY=AIzaSyBrocEcOCcq_k0EuAf_PFNX32G66D_qbeg
VITE_FIREBASE_AUTH_DOMAIN=shakala-pos.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=shakala-pos
VITE_FIREBASE_STORAGE_BUCKET=shakala-pos.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=450524089575
VITE_FIREBASE_APP_ID=1:450524089575:web:b42f855de3060497ef6642
VITE_FIREBASE_MEASUREMENT_ID=G-55N7ZLG24G
